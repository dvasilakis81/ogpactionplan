<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="4.0" client="site" method="upgrade">
  <name>MOD_ACTION_PLAN</name>
  <description>MOD_ACTION_PLAN_XML_DESCRIPTION</description>
  <author>Rinenweb</author>
  <authorEmail>info@rinenweb.eu</authorEmail>
  <creationDate>2026-10-21</creationDate>
  <license>GNU General Public License version 3 or later</license>
  <version>1.1.0</version>
  <scriptfile>script.php</scriptfile>
  <files>
    <filename module="mod_action_plan">mod_action_plan.php</filename>
    <folder>tmpl</folder>
  </files>
  <languages>
    <language tag="en-GB">language/en-GB/mod_action_plan.ini</language>
    <language tag="en-GB">language/en-GB/mod_action_plan.sys.ini</language>
    <language tag="el-GR">language/el-GR/mod_action_plan.ini</language>
    <language tag="el-GR">language/el-GR/mod_action_plan.sys.ini</language>
  </languages>
  <config>
    <fields name="params">
      <fieldset name="basic">
        <field name="action_plan_items" type="subform" label="MOD_ACTION_PLAN_ITEM" multiple="true">
          <form>
            <fields name="action_plan_items_fields">
              <field name="subject" type="text" filter="string" label="MOD_ACTION_PLAN_ITEM_SUBJECT" />
              <field name="subject_url" type="url" filter="url" label="MOD_ACTION_PLAN_ITEM_SUBJECT_URL" />
              <field name="milestone_fields" type="subform" label="MOD_ACTION_PLAN_ITEM_MILESTONE_FIELDS" multiple="true">
                <form>
                  <fields name="milestone_fields">
                    <field name="milestone_subject" type="text" filter="string" label="MOD_MILESTONE_SUBJECT" />
                    <field name="milestone_start_date" type="calendar" label="MOD_MILESTONE_CHOOSE_START_DATE" />
                    <field name="milestone_end_date" type="calendar" label="MOD_MILESTONE_CHOOSE_END_DATE" />
                    <field name="list_milestone_status" type="list" label="MOD_MILESTONE_CHOOSE_STATUS" default="started">
                      <option value="started">MOD_MILESTONE_STATUS_STARTED</option>
                      <option value="in_progress">MOD_MILESTONE_STATUS_IN_PROGRESS</option>
                      <option value="cancelled">MOD_MILESTONE_STATUS_CANCELLED</option>
                      <option value="completed">MOD_MILESTONE_STATUS_COMPLETED</option>
                      <option value="incomplete">MOD_MILESTONE_STATUS_INCOMPLETE</option>
                    </field>
                    <field name="milestone_results" type="editor" filter="\Joomla\CMS\Component\ComponentHelper::filterText" label="MOD_MILESTONE_RESULTS" />
                  </fields>
                </form>
              </field>
            </fields>
          </form>
        </field>
      </fieldset>
    </fields>
  </config>
</extension>
